{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubesandbox.io/schemas/component.schema.json",
  "title": "KubeSandbox Component manifest",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "kubesandbox.io/v1" },
    "kind": { "const": "Component" },
    "metadata": {
      "type": "object",
      "required": ["name", "version", "category"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?([+-][0-9A-Za-z.-]+)?$" },
        "category": {
          "type": "string",
          "enum": ["language", "database", "tool", "service", "base", "build-strategy"]
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["source", "runtime", "access"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["image", "dockerfile", "compose", "pipeline", "helm"] },
            "image": {
              "type": "object",
              "required": ["repository", "tag"],
              "additionalProperties": false,
              "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" }
              }
            },
            "dockerfile": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "context": { "type": "string" },
                "path": { "type": "string" }
              }
            },
            "compose": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "file": { "type": "string" } }
            },
            "pipeline": {
              "type": "object",
              "required": ["steps"],
              "additionalProperties": false,
              "properties": {
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "run"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string" },
                      "run": { "type": "string" }
                    }
                  }
                },
                "cache": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": { "type": "string" },
                    "store": { "type": "string", "enum": ["object"] }
                  }
                }
              }
            },
            "helm": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chart": { "type": "string" },
                "values": { "type": "object" }
              }
            }
          },
          "allOf": [
            { "if": { "properties": { "type": { "const": "image" } } }, "then": { "required": ["image"] } },
            { "if": { "properties": { "type": { "const": "dockerfile" } } }, "then": { "required": ["dockerfile"] } },
            { "if": { "properties": { "type": { "const": "compose" } } }, "then": { "required": ["compose"] } },
            { "if": { "properties": { "type": { "const": "pipeline" } } }, "then": { "required": ["pipeline"] } },
            { "if": { "properties": { "type": { "const": "helm" } } }, "then": { "required": ["helm"] } }
          ]
        },
        "provides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "languageId": { "type": "string" },
            "commands": { "type": "array", "items": { "type": "string" } },
            "fileExtensions": { "type": "array", "items": { "type": "string" } },
            "versionCommand": { "type": "string" },
            "defaultRun": { "type": "string" },
            "batchRunner": {
              "type": "object",
              "required": ["entrypoint"],
              "additionalProperties": false,
              "properties": {
                "entrypoint": { "type": "string" },
                "supportsVariableDump": { "type": "boolean", "default": false },
                "stdinMode": { "type": "string", "enum": ["upfront"], "default": "upfront" }
              }
            },
            "service": {
              "type": "object",
              "required": ["protocol", "port"],
              "additionalProperties": false,
              "properties": {
                "protocol": { "type": "string" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "dsnEnv": { "type": "string" }
              }
            }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["kind", "resources"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["mainTool", "sidecar", "init", "ephemeral"] },
            "weightClass": { "type": "string", "enum": ["light", "standard", "heavy"], "default": "light" },
            "resources": {
              "type": "object",
              "required": ["requests", "limits"],
              "additionalProperties": false,
              "properties": {
                "requests": { "$ref": "#/$defs/resourceQuantities" },
                "limits": { "$ref": "#/$defs/resourceQuantities" }
              }
            },
            "env": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "additionalProperties": false,
                "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
              }
            },
            "volumeMounts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "mountPath"],
                "additionalProperties": false,
                "properties": { "name": { "type": "string" }, "mountPath": { "type": "string" } }
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "containerPort"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
                }
              }
            },
            "healthCheck": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "exec": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "access": {
          "type": "object",
          "required": ["filesystem", "limits"],
          "additionalProperties": false,
          "properties": {
            "network": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "egress": { "type": "string", "enum": ["intent-only", "denied"], "default": "denied" },
                "reason": { "type": "string" },
                "reachableFrom": { "type": "string", "enum": ["same-pod-only"] }
              }
            },
            "packages": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "manager": { "type": "string" },
                "install": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean", "default": false },
                    "source": { "type": "string", "enum": ["mirror"] },
                    "mirror": { "type": "string", "format": "uri" },
                    "denylist": { "type": "array", "items": { "type": "string" } },
                    "allowlist": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            },
            "filesystem": {
              "type": "object",
              "required": ["workdir", "writablePaths"],
              "additionalProperties": false,
              "properties": {
                "workdir": { "type": "string" },
                "writablePaths": { "type": "array", "items": { "type": "string" } },
                "readOnlyRootFilesystem": { "type": "boolean", "default": true }
              }
            },
            "limits": {
              "type": "object",
              "required": ["processes", "outputBytes", "wallClockSeconds"],
              "additionalProperties": false,
              "properties": {
                "processes": { "type": "integer", "minimum": 1 },
                "outputBytes": { "type": "integer", "minimum": 1 },
                "wallClockSeconds": { "type": "integer", "minimum": 1 }
              }
            },
            "database": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "superuser": { "type": "boolean", "const": false },
                "role": { "type": "string" },
                "grants": { "type": "array", "items": { "type": "string" } },
                "forbidden": { "type": "array", "items": { "type": "string" } },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "maxConnections": { "type": "integer", "minimum": 1 },
                    "statementTimeout": { "type": "string" },
                    "maxDbSizeMB": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        },
        "requires": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@.+$" }
        },
        "hooks": {
          "type": "object",
          "required": ["module"],
          "additionalProperties": false,
          "properties": { "module": { "type": "string" } }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "environments": {
              "type": "array",
              "items": { "type": "string", "enum": ["local", "aks-prod"] },
              "minItems": 1
            },
            "runtimeClass": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "local": { "type": "string" },
                "aks-prod": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resourceQuantities": {
      "type": "object",
      "required": ["cpu", "memory"],
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
        "memory": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi)$" }
      }
    }
  }
}
