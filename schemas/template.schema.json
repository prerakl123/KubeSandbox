{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubesandbox.io/schemas/template.schema.json",
  "title": "KubeSandbox SandboxTemplate manifest",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "kubesandbox.io/v1" },
    "kind": { "const": "SandboxTemplate" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
        "displayName": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["base", "components", "resources", "ttl"],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "object",
          "required": ["ref"],
          "additionalProperties": false,
          "properties": { "ref": { "type": "string" } }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ref"],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^(tenant/[a-z0-9-]+/)?[a-z0-9][a-z0-9-]*@.+$"
              }
            }
          }
        },
        "weightClass": { "type": "string", "enum": ["light", "standard", "heavy"] },
        "workspace": {
          "type": "object",
          "required": ["persistent"],
          "additionalProperties": false,
          "properties": {
            "persistent": { "type": "boolean" },
            "sizeMB": { "type": "integer", "minimum": 1 }
          }
        },
        "resources": {
          "type": "object",
          "required": ["cpu", "memory"],
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi)$" },
            "ephemeralStorageMB": { "type": "integer", "minimum": 1 }
          }
        },
        "ttl": {
          "type": "object",
          "required": ["idle", "max"],
          "additionalProperties": false,
          "properties": {
            "idle": { "type": "string", "pattern": "^[0-9]+[smh]$" },
            "max": { "type": "string", "pattern": "^[0-9]+[smh]$" }
          }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    }
  }
}
